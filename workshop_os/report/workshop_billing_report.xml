<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_workshop_billing" model="ir.actions.report">
        <field name="name">Monthly Report</field>
        <field name="model">workshop.billing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">workshop_os.report_workshop_billing</field>
        <field name="report_file">workshop_os.report_workshop_billing</field>
        <field name="print_report_name">'Fechamento - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_workshop"/>
        <field name="binding_model_id" ref="model_workshop_billing"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_workshop_billing_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="b.company_id"/>
            <div class="page wo">
                <t t-call="workshop_os.report_workshop_styles"/>
                <t t-call="workshop_os.report_workshop_brand">
                    <div class="label">Monthly report</div>
                    <h2 t-field="b.partner_id.commercial_partner_id.name"/>
                    <div class="muted">
                        <span t-field="b.date_from"/> to <span t-field="b.date_to"/> · <t t-out="b.order_count"/> work orders
                    </div>
                </t>

                <div class="label">By service</div>
                <table class="items">
                    <thead>
                        <tr><th>Service</th><th style="text-align: right;">Qty</th><th style="text-align: right;">Amount</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="b._service_summary()" t-as="row">
                            <td t-out="row[0]"/>
                            <td style="text-align: right;" t-out="'%g' % row[1]"/>
                            <td style="text-align: right;"><span t-out="row[2]" t-options='{"widget": "monetary", "display_currency": b.currency_id}'/></td>
                        </tr>
                    </tbody>
                </table>
                <div style="text-align: right; margin: 8px 0 18px;">
                    <span class="label">Total of the period</span><br/>
                    <span class="total" t-field="b.amount_total"/>
                </div>

                <div class="label">Work orders</div>
                <table class="items">
                    <thead>
                        <tr><th>Order</th><th>Date</th><th>Plate</th><th>Vehicle</th><th>Brought by</th><th style="text-align: right;">Amount</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="b.order_ids.sorted('date_done')" t-as="o">
                            <td><span t-field="o.name"/></td>
                            <td><span t-field="o.date_done" t-options='{"widget": "date"}'/></td>
                            <td><strong t-out="o.plate"/></td>
                            <td t-out="' '.join(filter(None, [o.vehicle_id.brand, o.vehicle_id.model]))"/>
                            <td><span t-field="o.driver_name"/></td>
                            <td style="text-align: right;"><span t-field="o.amount_total"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_workshop_billing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="b">
                <t t-call="workshop_os.report_workshop_billing_document" t-lang="b.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
