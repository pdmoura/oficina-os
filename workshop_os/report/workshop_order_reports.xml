<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The documents draw their own header, so the page needs no room reserved for the company layout's one. -->
    <record id="paperformat_workshop" model="report.paperformat">
        <field name="name">Workshop A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_workshop_order" model="ir.actions.report">
        <field name="name">Work Order</field>
        <field name="model">workshop.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">workshop_os.report_workshop_order</field>
        <field name="report_file">workshop_os.report_workshop_order</field>
        <field name="print_report_name">'%s - %s' % (object.name, object.plate or '')</field>
        <field name="paperformat_id" ref="paperformat_workshop"/>
        <field name="binding_model_id" ref="model_workshop_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
