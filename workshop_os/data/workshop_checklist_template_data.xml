        <field name="sequence">1</field>
    </record>
    <record id="checklist_truck_entry_item_01" model="workshop.checklist.template.item"><field name="template_id" ref="checklist_truck_entry"/><field name="sequence">1</field><field name="section">Cab</field><field name="name">Dashboard with no warning lights</field></record>
