<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Public page the customer opens from WhatsApp: follow the job, see photos, approve with a signature. -->
    <template id="public_order_page" name="Work order: customer page">&lt;!DOCTYPE html&gt;
        <html t-att-lang="(order.partner_id.lang or 'pt_BR').replace('_', '-')">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0F1115"/>
                <meta name="robots" content="noindex"/>
                <title t-out="'%s · %s' % (order.name, company.name)"/>
                <t t-call-assets="workshop_os.assets_public" t-js="false"/>
                <style t-out="':root { --wo-accent: %s; }' % accent"/>
            </head>
            <body class="wo-public">
                <header class="wo-hero">
                    <div class="wo-hero__brand">
                        <img t-if="company.logo" t-att-src="'/web/image/res.company/%s/logo/160x160' % company.id" alt="" class="wo-hero__logo"/>
                        <div>
                            <div class="wo-hero__company" t-out="company.name"/>
                            <div class="wo-hero__sub" t-out="order.name"/>
                        </div>
                    </div>
                    <div class="wo-plate wo-plate--lg"><span class="wo-plate__band">BRASIL</span><span class="wo-plate__text" t-out="order.plate"/></div>
                    <div class="wo-hero__vehicle" t-out="' '.join(filter(None, [order.vehicle_id.brand, order.vehicle_id.model, order.vehicle_id.year]))"/>
                </header>

                <main class="wo-main">
                    <section class="wo-card">
                        <div class="wo-card__label">Status</div>
                        <div class="wo-status">
                            <span class="wo-dot" t-attf-style="background: {{ order.stage_id.color or '#64748B' }}"/>
                            <strong t-out="order.stage_id.name"/>
                            <span class="wo-badge" t-attf-class="wo-badge wo-badge--{{ order.state }}"
                                  t-out="dict(order._fields['state']._description_selection(order.env)).get(order.state)"/>
                        </div>
                        <ol class="wo-steps">
                            <t t-set="reached" t-value="True"/>
                            <li t-foreach="stages" t-as="stage" t-attf-class="{{ 'is-current' if stage == order.stage_id else '' }}">
                                <span t-out="stage.name"/>
                            </li>
                        </ol>
                        <div class="wo-meta">
                            <div><span>Arrived</span><strong t-field="order.date_in" t-options='{"widget": "datetime", "format": "dd/MM HH:mm"}'/></div>
                            <div t-if="order.date_promised"><span>Promised</span><strong t-field="order.date_promised" t-options='{"widget": "datetime", "format": "dd/MM HH:mm"}'/></div>
                            <div t-if="order.odometer"><span>Odometer</span><strong t-out="'{:,} km'.format(order.odometer).replace(',', '.')"/></div>
                        </div>
                    </section>

                    <section class="wo-card" t-if="order.complaint or order.diagnosis">
                        <div class="wo-card__label">What we found</div>
                        <p t-if="order.complaint" class="wo-muted" t-out="order.complaint"/>
                        <p t-if="order.diagnosis" t-out="order.diagnosis"/>
                    </section>

                    <section class="wo-card" t-if="photos">
                        <div class="wo-card__label">Photos</div>
                        <div class="wo-gallery">
                            <a t-foreach="photos" t-as="photo" t-att-href="photo.url" target="_blank" rel="noopener">
                                <img t-att-src="photo.thumb_url" loading="lazy" alt="Photo of the vehicle"/>
                            </a>
                        </div>
                    </section>

                    <section class="wo-card" t-if="lines">
                        <div class="wo-card__label">Services</div>
                        <ul class="wo-lines" id="wo-lines">
                            <li t-foreach="lines" t-as="line" t-attf-class="wo-line wo-line--{{ line.approval }}">
                                <label>
                                    <input t-if="order.state == 'draft'" type="checkbox" checked="checked" class="wo-line__check"
                                           t-att-value="line.id" t-att-data-amount="line.subtotal"/>
                                    <span class="wo-line__name" t-out="line.name"/>
                                    <span class="wo-line__qty" t-if="line.quantity != 1" t-out="'× %g' % line.quantity"/>
                                    <span class="wo-line__amount" t-field="line.subtotal"/>
                                </label>
                            </li>
                        </ul>
                        <div class="wo-total"><span>Total</span><strong id="wo-total" t-field="order.amount_total"/></div>
                    </section>

                    <section class="wo-card" t-if="order.state != 'draft' and order.approved_by">
                        <div class="wo-card__label">Answer</div>
                        <p>
                            <t t-if="order.state == 'rejected'">Rejected</t><t t-else="">Approved</t>
                            by <strong t-out="order.approved_by"/> on
                            <span t-field="order.approved_on" t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>.
                        </p>
                    </section>

                    <p class="wo-foot">
                        <t t-out="company.name"/><t t-if="company.phone"> · <a t-att-href="'tel:%s' % company.phone" t-out="company.phone"/></t>
                    </p>
                </main>

                <div t-if="order.state == 'draft' and lines" class="wo-actionbar" id="wo-actionbar"
                     t-att-data-token="order.access_token" t-att-data-currency="order.currency_id.symbol">
                    <div class="wo-actionbar__total"><span>To approve</span><strong id="wo-approve-total" t-field="order.amount_total"/></div>
                    <button type="button" class="wo-btn wo-btn--ghost" data-wo-open="reject">Reject</button>
                    <button type="button" class="wo-btn" data-wo-open="approve">Approve</button>
                </div>

                <dialog class="wo-dialog" id="wo-dialog">
                    <form method="dialog" id="wo-form">
                        <h2 id="wo-dialog-title">Approve the services</h2>
                        <span id="wo-t-approve" hidden="hidden">Approve the services</span>
                        <span id="wo-t-reject" hidden="hidden">Reject the quote</span>
                        <p class="wo-muted wo-terms" t-out="company.workshop_terms_text"/>
                        <label class="wo-field">Your name
                            <input type="text" id="wo-name" required="required" maxlength="120" autocomplete="name"/>
                        </label>
                        <div class="wo-sign" id="wo-sign-block">
                            <div class="wo-sign__head"><span>Signature (optional)</span><button type="button" class="wo-link" id="wo-sign-clear">Clear</button></div>
                            <canvas id="wo-sign" width="600" height="200"/>
                        </div>
                        <p class="wo-error" id="wo-error" hidden="hidden"/>
                        <div class="wo-dialog__actions">
                            <button type="button" class="wo-btn wo-btn--ghost" id="wo-cancel">Back</button>
                            <button type="submit" class="wo-btn" id="wo-submit">Confirm</button>
                        </div>
                    </form>
                </dialog>
                <t t-call-assets="workshop_os.assets_public" t-css="false"/>
            </body>
        </html>
    </template>
</odoo>
