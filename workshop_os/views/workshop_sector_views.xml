<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_sector_view_list" model="ir.ui.view">
        <field name="name">workshop.sector.view.list</field>
        <field name="model">workshop.sector</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="workshop_sector_action" model="ir.actions.act_window">
        <field name="name">Sectors</field>
        <field name="res_model">workshop.sector</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
