<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_stage_view_list" model="ir.ui.view">
        <field name="name">workshop.stage.list</field>
        <field name="model">workshop.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color"/>
                <field name="is_waiting"/>
                <field name="fold"/>
                <field name="order_count" string="Open orders"/>
            </list>
        </field>
    </record>
    <record id="action_workshop_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">workshop.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="workshop_location_view_list" model="ir.ui.view">
        <field name="name">workshop.location.list</field>
        <field name="model">workshop.location</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_workshop_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">workshop.location</field>
        <field name="view_mode">list</field>
    </record>

    <record id="workshop_sector_view_list" model="ir.ui.view">
        <field name="name">workshop.sector.list</field>
        <field name="model">workshop.sector</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_workshop_sector" model="ir.actions.act_window">
        <field name="name">Sectors</field>
        <field name="res_model">workshop.sector</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
