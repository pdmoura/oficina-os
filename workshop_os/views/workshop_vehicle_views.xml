<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_vehicle_view_list" model="ir.ui.view">
        <field name="name">workshop.vehicle.list</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="plate_display" string="Plate" class="fw-bold"/>
                <field name="fleet_number" optional="show"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="year" optional="show"/>
                <field name="partner_id"/>
                <field name="odometer" optional="show"/>
                <field name="order_count" string="Orders" optional="show"/>
                <field name="last_visit" optional="show" widget="date"/>
            </list>
        </field>
    </record>

    <record id="workshop_vehicle_view_form" model="ir.ui.view">
        <field name="name">workshop.vehicle.form</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="plate"/>
                        <h1><field name="plate" placeholder="ABC1D23" class="o_workshop_plate_input"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="fleet_number"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="fuel"/>
                            <field name="chassis"/>
                            <field name="odometer"/>
                            <field name="open_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes about this vehicle..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="workshop_vehicle_view_kanban" model="ir.ui.view">
        <field name="name">workshop.vehicle.kanban</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_workshop_kanban">
                <templates>
                    <t t-name="card" class="o_workshop_card">
                        <div class="d-flex align-items-center gap-2">
                            <field name="plate" widget="workshop_plate"/>
                            <div class="min-w-0">
                                <div class="fw-bold text-truncate"><field name="brand"/> <field name="model"/></div>
                                <div class="small text-muted"><field name="year"/><span invisible="not fleet_number"> · #<field name="fleet_number"/></span></div>
                            </div>
                        </div>
                        <field name="partner_id" class="fw-semibold text-truncate mt-2"/>
                        <footer class="pt-1 small text-muted">
                            <span><i class="fa fa-wrench me-1"/><field name="order_count"/> OS</span>
                            <span class="ms-auto" invisible="not last_visit"><field name="last_visit" widget="date"/></span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="workshop_vehicle_view_search" model="ir.ui.view">
        <field name="name">workshop.vehicle.search</field>
        <field name="model">workshop.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="plate" string="Plate"/>
                <field name="fleet_number"/>
                <field name="partner_id"/>
                <field name="model"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_workshop_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">workshop.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_workshop_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('workshop_customer', '=', True)]</field>
        <field name="context">{'default_workshop_customer': True, 'default_is_company': True}</field>
    </record>

    <record id="res_partner_view_form_workshop" model="ir.ui.view">
        <field name="name">res.partner.form.workshop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_workshop_vehicles" type="object" class="oe_stat_button" icon="fa-truck"
                        groups="workshop_os.group_workshop_user" invisible="not workshop_customer">
                    <field name="workshop_vehicle_count" widget="statinfo" string="Vehicles"/>
                </button>
                <button name="action_workshop_orders" type="object" class="oe_stat_button" icon="fa-wrench"
                        groups="workshop_os.group_workshop_user" invisible="not workshop_customer">
                    <field name="workshop_order_count" widget="statinfo" string="Work orders"/>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Workshop" name="workshop" groups="workshop_os.group_workshop_user">
                    <group>
                        <field name="workshop_customer"/>
                        <field name="workshop_auto_approve" invisible="not workshop_customer"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
