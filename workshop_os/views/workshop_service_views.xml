<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_service_view_list" model="ir.ui.view">
        <field name="name">workshop.service.list</field>
        <field name="model">workshop.service</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <field name="favorite" widget="boolean_favorite" nolabel="1"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="sector_id" optional="show"/>
                <field name="list_price" sum="Total"/>
                <field name="cost" optional="hide"/>
                <field name="hours" widget="float_time"/>
                <field name="usage_count" string="Used" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <!-- On a phone the list is too wide: Odoo opens this card view there instead. -->
    <record id="workshop_service_view_kanban" model="ir.ui.view">
        <field name="name">workshop.service.kanban</field>
        <field name="model">workshop.service</field>
        <field name="arch" type="xml">
            <kanban class="o_workshop_kanban">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card" class="o_workshop_card">
                        <div class="d-flex align-items-center gap-2">
                            <field name="favorite" widget="boolean_favorite" nolabel="1"/>
                            <field name="name" class="fw-bold flex-grow-1"/>
                            <field name="list_price" class="fw-bold text-nowrap"/>
                        </div>
                        <footer class="pt-1 small text-muted">
                            <field name="sector_id" class="o_workshop_chip" invisible="not sector_id"/>
                            <span class="ms-auto d-inline-flex align-items-center gap-1">
                                <i class="fa fa-clock-o"/><field name="hours" widget="float_time"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="workshop_service_view_form" model="ir.ui.view">
        <field name="name">workshop.service.form</field>
        <field name="model">workshop.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title d-flex align-items-center gap-2">
                        <field name="favorite" widget="boolean_favorite" nolabel="1"/>
                        <h1 class="flex-grow-1"><field name="name" placeholder="Headlight replacement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sector_id"/>
                            <field name="code"/>
                            <field name="hours" widget="float_time"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="cost"/>
                            <field name="usage_count" string="Used"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="workshop_service_view_search" model="ir.ui.view">
        <field name="name">workshop.service.search</field>
        <field name="model">workshop.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="sector_id"/>
                <filter name="favorite" string="Favourites" domain="[('favorite', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_sector" string="Sector" context="{'group_by': 'sector_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_workshop_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">workshop.service</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the services you sell</p>
            <p>Price and labour hours are copied to the work order. Starred services become one-tap buttons in the
                mechanic app.</p>
        </field>
    </record>
</odoo>
