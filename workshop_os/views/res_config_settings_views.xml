<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.workshop_os</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Workshop" name="workshop_os" groups="workshop_os.workshop_os_group_manager">
                    <block title="Brand" name="workshop_brand">
                        <setting string="Colours and logo" help="The accent colours buttons and highlights across the system, the mechanic app, the customer pages and the login; the background colour paints the top bar and the login page">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="workshop_accent_color" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_accent_color" widget="color"/>
                                </div>
                                <div class="row">
                                    <label for="workshop_login_background" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_login_background" widget="color"/>
                                </div>
                                <div class="row">
                                    <label for="workshop_login_theme" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_login_theme" widget="radio" options="{'horizontal': true}"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Logo for dark backgrounds" help="Full logo for the customer page and the office dashboard. Documents and the login page use the company logo">
                            <field name="workshop_logo_dark" widget="image" class="w-25" options="{'size': [160, 96]}"/>
                        </setting>
                        <setting string="Symbol" help="The logo without text, for the mechanic app header and the phone icon">
                            <field name="workshop_logo_mark" widget="image" class="w-25" options="{'size': [96, 96]}"/>
                        </setting>
                        <setting string="Symbol for light backgrounds" help="The symbol shown by the light theme of the mechanic app and the dashboard">
                            <field name="workshop_logo_mark_light" widget="image" class="w-25" options="{'size': [96, 96]}"/>
                        </setting>
                        <setting string="Browser icon" help="Tab icon and phone shortcuts (.ico or .png). An .ico with several sizes keeps each size exactly as drawn">
                            <field name="workshop_favicon" widget="image" class="w-25" options="{'size': [48, 48]}"/>
                        </setting>
                        <setting string="Link preview image" help="Picture shown when a link to the system or to a work order is shared, e.g. on WhatsApp (1200×630)">
                            <field name="workshop_og_image" widget="image" class="w-50" options="{'size': [240, 126]}"/>
                        </setting>
                        <setting string="Phone app icon" help="Optional square image (512 px). Without it, the icon is made from the symbol">
                            <field name="workshop_app_icon" widget="image" class="w-25" options="{'size': [96, 96]}"/>
                        </setting>
                    </block>
                    <block title="Texts" name="workshop_texts">
                        <setting string="Warranty" help="Printed on every work order">
                            <field name="workshop_warranty_text" class="w-100"/>
                        </setting>
                        <setting string="Approval terms" help="The customer accepts these terms on the approval page">
                            <field name="workshop_terms_text" class="w-100"/>
                        </setting>
                    </block>
                    <block title="Photos" name="workshop_photos">
                        <setting string="Where photos are stored"
                                 help="Database works everywhere. Cloudinary keeps the database small and serves images faster">
                            <field name="workshop_photo_storage" widget="radio"/>
                            <div class="content-group" invisible="workshop_photo_storage != 'cloudinary'">
                                <div class="row mt8">
                                    <label for="workshop_cloudinary_cloud_name" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_cloudinary_cloud_name"/>
                                </div>
                                <div class="row">
                                    <label for="workshop_cloudinary_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_cloudinary_api_key"/>
                                </div>
                                <div class="row">
                                    <label for="workshop_cloudinary_api_secret" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_cloudinary_api_secret" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="workshop_cloudinary_folder" class="col-lg-4 o_light_label"/>
                                    <field name="workshop_cloudinary_folder"/>
                                </div>
                                <button name="action_workshop_test_cloudinary" type="object" string="Test connection"
                                        class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'workshop_os', 'bin_size': False}</field>
    </record>
</odoo>
