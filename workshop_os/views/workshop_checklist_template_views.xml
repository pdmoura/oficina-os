<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_checklist_template_view_list" model="ir.ui.view">
        <field name="name">workshop.checklist.template.view.list</field>
        <field name="model">workshop.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="vehicle_type"/>
                <field name="item_count" string="Items"/>
            </list>
        </field>
    </record>
    <record id="workshop_checklist_template_view_form" model="ir.ui.view">
        <field name="name">workshop.checklist.template.view.form</field>
        <field name="model">workshop.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Truck arrival"/></h1></div>
                    <group>
                        <group><field name="kind"/></group>
                        <group><field name="vehicle_type"/></group>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="section"/>
                            <field name="name"/>
                        </list>
                        <kanban class="o_workshop_line_kanban">
                            <templates>
                                <t t-name="card">
                                    <field name="section" class="d-block small text-muted"/>
                                    <field name="name" class="fw-bold"/>
                                </t>
                            </templates>
                        </kanban>
                        <form>
                            <group>
                                <field name="section"/>
                                <field name="name"/>
                                <field name="sequence"/>
                            </group>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="workshop_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">workshop.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
