<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_workshop" model="ir.module.category">
        <field name="name">Workshop</field>
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_workshop">
        <field name="name">Workshop</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_workshop"/>
    </record>

    <record id="group_workshop_user" model="res.groups">
        <field name="name">Mechanic</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Opens and runs work orders, takes photos and fills checklists. Cannot approve or bill.</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Office</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approves orders, manages prices, settings and the monthly closing.</field>
    </record>

    <data noupdate="1">
        <record id="workshop_order_company_rule" model="ir.rule">
            <field name="name">Work orders: multi-company</field>
            <field name="model_id" ref="model_workshop_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="workshop_vehicle_company_rule" model="ir.rule">
            <field name="name">Vehicles: multi-company</field>
            <field name="model_id" ref="model_workshop_vehicle"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="workshop_billing_company_rule" model="ir.rule">
            <field name="name">Monthly closing: multi-company</field>
            <field name="model_id" ref="model_workshop_billing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
