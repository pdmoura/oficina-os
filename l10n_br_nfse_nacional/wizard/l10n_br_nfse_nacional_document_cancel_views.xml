<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_br_nfse_nacional_document_cancel_view_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.cancel.view.form</field>
        <field name="model">l10n_br_nfse_nacional.document.cancel</field>
        <field name="arch" type="xml">
            <form>
                <p invisible="mode != 'assisted'" class="text-muted">
                    Cancel the note on the Emissor Nacional first; this only records the cancellation here.
                </p>
                <p invisible="mode != 'api'" class="text-muted">
                    The cancellation event is signed and sent to the national system right away.
                </p>
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="reason_code" widget="radio"/>
                    <field name="reason" placeholder="e.g. Amount typed wrong, a new note replaces this one"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel NFS-e" class="btn-danger"/>
                    <button special="cancel" string="Back"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
