<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_danfse" model="report.paperformat">
        <field name="name">DANFSe A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_danfse" model="ir.actions.report">
        <field name="name">DANFSe</field>
        <field name="model">l10n_br_nfse_nacional.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_br_nfse_nacional.report_danfse</field>
        <field name="report_file">l10n_br_nfse_nacional.report_danfse</field>
        <field name="print_report_name">'DANFSe-%s' % (object.nfse_number or object.id)</field>
        <field name="paperformat_id" ref="paperformat_danfse"/>
        <field name="binding_model_id" ref="model_l10n_br_nfse_nacional_document"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
