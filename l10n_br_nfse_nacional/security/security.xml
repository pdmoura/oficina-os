<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_nfse">
        <field name="name">NFS-e</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_nfse_user" model="res.groups">
        <field name="name">Issuer</field>
        <field name="privilege_id" ref="res_groups_privilege_nfse"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Issues and cancels service invoices (NFS-e).</field>
    </record>

    <data noupdate="1">
        <record id="nfse_document_company_rule" model="ir.rule">
            <field name="name">NFS-e: multi-company</field>
            <field name="model_id" ref="model_nfse_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
