<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nfse" model="res.groups.privilege">
        <field name="name">NFS-e</field>
        <field name="sequence">60</field>
    </record>

    <record id="l10n_br_nfse_nacional_group_user" model="res.groups">
        <field name="name">Issuer</field>
        <field name="privilege_id" ref="res_groups_privilege_nfse"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Issues and cancels service invoices (NFS-e).</field>
    </record>
</odoo>
