# Copy to deploy/.env (never committed) and change every password.

# Administrator created on the first boot; change it later inside Odoo.
ODOO_ADMIN_EMAIL=admin@example.com
ODOO_ADMIN_PASSWORD=change-this-password

# Password of the PostgreSQL that runs next to Odoo.
DB_PASSWORD=change-this-database-password
DB_NAME=odoo

# true loads sample data (for a demo), false for a real shop.
LOAD_DEMO=false

# Local port for the reverse proxy, and resource caps so Odoo never starves the rest of the machine.
ODOO_PORT=8069
ODOO_MEMORY=2g
ODOO_CPUS=1.5
DB_MEMORY=1g
DB_CPUS=1.0
BACKUP_DAYS=14
