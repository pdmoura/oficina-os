<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_billing_view_form_nfse" model="ir.ui.view">
        <field name="name">workshop.billing.form.nfse</field>
        <field name="model">workshop.billing</field>
        <field name="inherit_id" ref="workshop_os.workshop_billing_view_form"/>
        <field name="arch" type="xml">
            <button name="action_mark_paid" position="before">
                <button name="action_create_nfse" type="object" string="Issue NFS-e" class="btn-primary"
                        invisible="state not in ('confirmed', 'invoiced') or nfse_state == 'done'"/>
            </button>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_nfse" type="object" class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not nfse_count">
                        <field name="nfse_count" widget="statinfo" string="NFS-e"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="workshop_billing_view_list_nfse" model="ir.ui.view">
        <field name="name">workshop.billing.list.nfse</field>
        <field name="model">workshop.billing</field>
        <field name="inherit_id" ref="workshop_os.workshop_billing_view_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="nfse_state" widget="badge" optional="show"
                       decoration-success="nfse_state == 'done'" decoration-warning="nfse_state == 'draft'"/>
            </field>
        </field>
    </record>

    <record id="workshop_order_view_form_nfse" model="ir.ui.view">
        <field name="name">workshop.order.form.nfse</field>
        <field name="model">workshop.order</field>
        <field name="inherit_id" ref="workshop_os.workshop_order_view_form"/>
        <field name="arch" type="xml">
            <button name="action_send_whatsapp" position="before">
                <button name="action_create_nfse" type="object" string="Issue NFS-e"
                        invisible="state not in ('done', 'delivered') or billing_id or nfse_state == 'done'"
                        groups="workshop_os.group_workshop_manager"/>
            </button>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box" groups="workshop_os.group_workshop_manager">
                    <button name="action_view_nfse" type="object" class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not nfse_count">
                        <field name="nfse_count" widget="statinfo" string="NFS-e"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="nfse_document_view_form_workshop" model="ir.ui.view">
        <field name="name">nfse.document.form.workshop</field>
        <field name="model">nfse.document</field>
        <field name="inherit_id" ref="l10n_br_nfse_nacional.nfse_document_view_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="workshop_billing_id" invisible="not workshop_billing_id" readonly="1"/>
                <field name="workshop_order_id" invisible="not workshop_order_id" readonly="1"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_workshop_nfse" name="NFS-e" parent="workshop_os.menu_workshop_billing_root"
              action="l10n_br_nfse_nacional.action_nfse_document" sequence="15"/>
</odoo>
