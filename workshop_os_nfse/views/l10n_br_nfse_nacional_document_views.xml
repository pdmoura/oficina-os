<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_br_nfse_nacional_document_view_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.view.form.inherit.workshop_os_nfse</field>
        <field name="model">l10n_br_nfse_nacional.document</field>
        <field name="inherit_id" ref="l10n_br_nfse_nacional.l10n_br_nfse_nacional_document_view_form"/>
        <field name="arch" type="xml">
            <!-- Picking the order or the closing fills in the note; a note is usually created from them. -->
            <field name="partner_id" position="before">
                <field name="workshop_order_id" readonly="state != 'draft'" invisible="workshop_billing_id"
                       options="{'no_create': True}" placeholder="Pick a finished order to fill in the note"/>
                <field name="workshop_billing_id" readonly="state != 'draft'" invisible="workshop_order_id"
                       options="{'no_create': True}" placeholder="…or a confirmed monthly closing"/>
            </field>
        </field>
    </record>
</odoo>
